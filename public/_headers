# Cloudflare serves .xsl as application/xml, derived from the extension.
#
# Chromium applies the sitemap stylesheet at that type -- verified -- but the
# content type browsers are actually documented to accept for XSLT is text/xsl
# (or application/xslt+xml), and this could not be tested in Firefox or Safari
# from the build environment. Setting it explicitly costs nothing and removes
# the question.
#
# The Astro Cloudflare adapter appends its own /_astro/* immutable rule to this
# file during the build; both end up in dist/client/_headers.
/sitemap.xsl
  Content-Type: text/xsl; charset=utf-8
  Cache-Control: public, max-age=3600

# Host-scoped noindex for the workers.dev preview, covering everything the
# HTML <meta name="robots"> tag cannot: robots.txt, the sitemaps and every
# static image, none of which carry a <head>.
#
# _headers rules match on the request URL, host included, when the pattern is
# an absolute https:// URL -- this is Cloudflare's own documented pattern for
# exactly this case (developers.cloudflare.com/workers/static-assets/headers/
# -- "Prevent your workers.dev URLs showing in search results"), not a repo
# invention. It is scoped to *.workers.dev only: boldeimaging.com never
# matches this pattern, so this rule cannot follow
# the build to production at cutover the way a bare /* rule or an HTML meta
# tag would (see "The preview is noindexed" below for why that distinction
# matters here).
#
# It reaches only responses the Workers assets binding serves directly, i.e.
# every prerendered page, robots.txt, the sitemaps and every file under
# public/ or src/data uploads. It deliberately does NOT reach the three
# on-demand routes (/api/contact, /api/ftp, /img/[...path]) -- Cloudflare
# documents that _headers "rules are not applied to responses generated by
# your Worker code" even when the URL matches, so those three are covered
# instead by the same check in src/middleware.ts, which runs only for them.
https://:version.:subdomain.workers.dev/*
  X-Robots-Tag: noindex, nofollow, noarchive
