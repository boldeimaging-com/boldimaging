{
  "name": "boldimaging",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "check": "astro check",
    "types": "wrangler types",
    "deploy": "astro build && wrangler deploy -c dist/server/wrangler.json",
    "db:migrate": "wrangler d1 migrations apply boldeimaging-forms --remote",
    "db:migrate:local": "wrangler d1 migrations apply boldeimaging-forms --local",
    "db:list": "wrangler d1 migrations list boldeimaging-forms --remote"
  },
  "dependencies": {
    "@astrojs/cloudflare": "^14.3.0",
    "astro": "^7.3.1"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "typescript": "^6.0.3"
  }
}
