{
  // `name` must match the Cloudflare Worker this repo deploys to, exactly, or
  // the Workers Build fails with an error that names neither side clearly.
  "name": "boldimaging",
  "compatibility_date": "2026-09-03",
  "compatibility_flags": ["nodejs_compat"],

  // @astrojs/cloudflare v14 supplies `main` and the assets directory itself.
  // It merges this file with what it derives and writes the real deploy-time
  // config to dist/server/wrangler.json (main: entry.mjs, assets: ../client).
  //
  // So the deploy command is NOT a bare `wrangler deploy` -- that reads this
  // file, which has no `main`. It must point at the generated config:
  //
  //     npx wrangler deploy -c dist/server/wrangler.json
  //
  // which is what `npm run deploy` does.
  "assets": {
    "binding": "ASSETS",
    "not_found_handling": "404-page",
    "html_handling": "auto-trailing-slash"
  },

  // Contact enquiries and /ftp/ upload records. The email is the
  // notification; this is the record -- see migrations/0001_forms.sql.
  //
  // database_id is an identifier, not a secret: it is useless without account
  // credentials, and Wrangler needs it at build time, so it belongs in version
  // control rather than in a Worker secret.
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "boldeimaging-forms",
      "database_id": "ebc4c786-bf6b-4b66-ba8b-4bf2a7c5ff7a",
      "migrations_dir": "migrations"
    }
  ],

  // Reviewed at boldeimaging.10xid.com, in the studio's own 10xid.com zone --
  // NOT on the client's domain, which stays untouched until cutover.
  //
  // custom_domain, not a route: the Worker is the origin, so Cloudflare creates
  // the DNS record and issues the certificate itself. A route would expect a
  // real origin behind a proxied record, which is the wrong shape here.
  //
  // What Cloudflare creates is a proxied `AAAA <host> -> 100::` placeholder --
  // 100::/64 is the IPv6 discard prefix, so the record exists only to be
  // proxied and never receives traffic. The other client hostnames in this zone
  // carry the same record, which is how you can tell they are Custom Domains too.
  //
  // The zone has a proxied *.10xid.com wildcard at 185.206.163.79, so this name
  // resolved before it was ours and served 525. The Custom Domain's own record
  // is more specific than the wildcard and takes precedence.
  "routes": [{ "pattern": "boldeimaging.10xid.com", "custom_domain": true }],

  // Deliberate: this build is reviewed at boldimaging.ash-47a.workers.dev and
  // that URL is public. boldeimaging.com cannot host the preview yet -- its
  // zone is still pending on Cloudflare (nameservers remain at GoDaddy), so no
  // hostname under it resolves or can be issued a certificate.
  //
  // Revisit when the domain is pointed at the new site: the apex belongs to the
  // cutover step, never to this one.
  "workers_dev": true
}
