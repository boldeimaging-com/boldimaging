---
// /gallery/ — Elementor template post-619 wrapping the Pro "Gallery" widget.
//
//   #d92eec0  section     padding 150px 10px 50px (120px top <=767)
//   #4c7903c  title       Titillium 40/40 600 uppercase #808080
//   #0ff733d  gallery     layout "justified", ideal row height 162px
//                         (150 <=1024/767), gap 13px (10 <=1024/767),
//                         filter tabs Roboto 13px (#000, white on the active
//                         pill in brand blue), 20px above the grid,
//                         hover overlay rgba(0,0,0,0.5) over 800ms,
//                         click opens the full image in a lightbox
//
// The justified rows are computed in the browser, exactly as the original
// does, because a filter change reflows them.
import Base from '../layouts/Base.astro';
import { media } from '../consts';
import { loadGallery } from '../lib/gallery-source';

export const prerender = true;

// Read at build time from D1, falling back to src/data/gallery.ts when the
// database cannot be reached. The page stays static either way; see
// src/lib/gallery-source.ts for why the fallback exists.
const { filters: GALLERY_FILTERS, items: GALLERY_ITEMS, source } = loadGallery();
console.log(`[gallery] ${GALLERY_ITEMS.length} items, ${GALLERY_FILTERS.length} filters, from ${source}`);
---

<Base
  title="Gallery – BolDe Imaging"
  description="Photographs of BolDe Imaging signage projects, by type: awnings, banners, channel letters, construction, custom, cut out letters, fascia, hoarding, interiors, push thru, pylon and wayfinding."
>
  <section class="gallery-section">
    <div class="container">
      <div class="gallery-col">
        <h1 class="page-title">Gallery</h1>

        <div class="filters" role="tablist" aria-label="Gallery filter">
          <button class="filter is-active" type="button" role="tab" aria-selected="true" data-index="all">
            All
          </button>
          {
            GALLERY_FILTERS.map((name, i) => (
              <button class="filter" type="button" role="tab" aria-selected="false" data-index={String(i)}>
                {name}
              </button>
            ))
          }
        </div>

        <div class="gallery" id="gallery">
          {
            GALLERY_ITEMS.map((item) => (
              <a
                class="gallery__item"
                href={media(item.full)}
                data-tag={String(item.tag)}
                data-w={String(item.w)}
                data-h={String(item.h)}
                data-title={item.title}
                aria-label={item.title}
              >
                <img
                  src={media(item.thumb)}
                  width={item.w}
                  height={item.h}
                  alt={item.title}
                  loading="lazy"
                  decoding="async"
                />
                <span class="gallery__overlay"></span>
              </a>
            ))
          }
        </div>
      </div>
    </div>
  </section>

  <dialog class="lightbox" id="lightbox" aria-label="Gallery image">
    <button class="lightbox__close" type="button" data-close aria-label="Close">
      <i class="eicon-close" aria-hidden="true"></i>
    </button>
    <button class="lightbox__nav lightbox__nav--prev" type="button" data-prev aria-label="Previous image">
      <i class="eicon-chevron-left" aria-hidden="true"></i>
    </button>
    <img class="lightbox__img" id="lightbox-img" alt="" />
    <button class="lightbox__nav lightbox__nav--next" type="button" data-next aria-label="Next image">
      <i class="eicon-chevron-right" aria-hidden="true"></i>
    </button>
    <p class="lightbox__caption" id="lightbox-caption"></p>
  </dialog>
</Base>

<style>
  .gallery-section {
    padding: 150px 10px 50px;
  }

  /* #0ff733d filter tabs — centred in the 1140px column, which itself has
     no padding on the original. */
  .filters {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    margin-block-end: 9px;
  }

  .filter {
    padding: 7px 14px;
    border: 0;
    background: transparent;
    font-family: var(--font-button);
    font-size: 13px;
    line-height: 19.5px;
    font-weight: 400;
    color: #000;
    cursor: pointer;
    transition: color 0.3s, background-color 0.3s;
  }

  .filter:hover,
  .filter.is-active {
    background-color: var(--e-global-color-6ad8614);
    color: #fff;
  }

  /* The grid: items are absolutely positioned by the layout script. */
  .gallery {
    position: relative;
    margin-block-start: 20px;
  }

  .gallery__item {
    position: absolute;
    display: block;
    overflow: hidden;
  }

  .gallery__item img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 800ms;
  }

  .gallery__overlay {
    position: absolute;
    inset: 0;
    background-color: rgba(0, 0, 0, 0);
    transition: background-color 800ms;
  }

  .gallery__item:hover .gallery__overlay,
  .gallery__item:focus .gallery__overlay {
    background-color: rgba(0, 0, 0, 0.5);
  }

  /* Before the script runs (or with JS off) fall back to a plain flex wrap so
     the images are still visible and clickable. */
  .gallery:not([data-laid-out]) {
    display: flex;
    flex-wrap: wrap;
    gap: 13px;
  }

  .gallery:not([data-laid-out]) .gallery__item {
    position: static;
    height: 162px;
  }

  .gallery:not([data-laid-out]) .gallery__item img {
    width: auto;
    height: 162px;
  }

  /* Lightbox */
  .lightbox {
    width: 100vw;
    max-width: 100vw;
    height: 100vh;
    max-height: 100vh;
    padding: 0;
    border: 0;
    background: rgba(0, 0, 0, 0.9);
  }

  .lightbox::backdrop {
    background: rgba(0, 0, 0, 0.9);
  }

  .lightbox[open] {
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .lightbox__img {
    max-width: 90vw;
    max-height: 85vh;
    object-fit: contain;
  }

  .lightbox__close,
  .lightbox__nav {
    position: absolute;
    border: 0;
    background: transparent;
    color: #fff;
    cursor: pointer;
    line-height: 1;
  }

  .lightbox__close {
    top: 16px;
    right: 16px;
    font-size: 28px;
  }

  .lightbox__nav {
    top: 50%;
    transform: translateY(-50%);
    padding: 16px;
    font-size: 32px;
  }

  .lightbox__nav--prev {
    left: 8px;
  }

  .lightbox__nav--next {
    right: 8px;
  }

  .lightbox__caption {
    position: absolute;
    inset-inline: 0;
    bottom: 16px;
    margin: 0;
    font-family: var(--font-body);
    font-size: 15px;
    color: #fff;
    text-align: center;
  }

  @media (max-width: 767px) {
    .gallery-section {
      padding-top: 120px;
    }

    .filters {
      justify-content: center;
    }
  }
  /* The page title centres at the tablet breakpoint on this template. */
  @media (max-width: 1024px) {
    .page-title {
      text-align: center;
    }
  }
</style>

<script is:inline>
  (function () {
    var grid = document.getElementById('gallery');
    if (!grid) return;
    var items = Array.prototype.slice.call(grid.querySelectorAll('.gallery__item'));
    var filters = Array.prototype.slice.call(document.querySelectorAll('.filter'));
    var active = 'all';

    function settings() {
      // The widget declares ideal_row_height 162 / gap 13, with tablet and
      // mobile overrides of 150 / 10. Measuring the live site shows only the
      // gap override taking effect -- its rows resolve against 162 at every
      // width -- so that is what is used here.
      return { row: 162, gap: window.innerWidth <= 1024 ? 10 : 13 };
    }

    function visible() {
      return items.filter(function (el) {
        return active === 'all' || el.dataset.tag === active;
      });
    }

    // Justified layout. The break rule below was fitted against the live
    // site's own rows: scale each image to the ideal row height, add one gap
    // per image, and close the row as soon as that reaches the container
    // width. That reproduces 18 of the original's 19 rows exactly at 1600px,
    // heights included (the 19th sits on a rounding boundary).
    function layout() {
      var cfg = settings();
      var width = grid.clientWidth;
      if (!width) return;
      var shown = visible();
      items.forEach(function (el) {
        el.style.display = shown.indexOf(el) === -1 ? 'none' : 'block';
      });

      var y = 0;
      var row = [];
      var ratioSum = 0;

      function commit(isLast) {
        if (!row.length) return;
        var gaps = cfg.gap * (row.length - 1);
        var height = (width - gaps) / ratioSum;
        if (isLast && height > cfg.row * 1.5) height = cfg.row;
        var x = 0;
        row.forEach(function (entry, i) {
          var w = Math.round(entry.ratio * height);
          if (i === row.length - 1 && !isLast) w = Math.round(width - x);
          entry.el.style.left = x + 'px';
          entry.el.style.top = y + 'px';
          entry.el.style.width = w + 'px';
          entry.el.style.height = Math.round(height) + 'px';
          x += w + cfg.gap;
        });
        y += Math.round(height) + cfg.gap;
        row = [];
        ratioSum = 0;
      }

      shown.forEach(function (el) {
        var ratio = (parseFloat(el.dataset.w) || 4) / (parseFloat(el.dataset.h) || 3);
        row.push({ el: el, ratio: ratio });
        ratioSum += ratio;
        if (ratioSum * cfg.row + cfg.gap * row.length >= width) commit(false);
      });
      commit(true);

      grid.style.height = Math.max(0, y - cfg.gap) + 'px';
      grid.setAttribute('data-laid-out', '');
    }

    filters.forEach(function (btn) {
      btn.addEventListener('click', function () {
        active = btn.dataset.index;
        filters.forEach(function (b) {
          b.classList.toggle('is-active', b === btn);
          b.setAttribute('aria-selected', String(b === btn));
        });
        layout();
      });
    });

    var resizeTimer;
    window.addEventListener('resize', function () {
      clearTimeout(resizeTimer);
      resizeTimer = setTimeout(layout, 120);
    });
    if (document.fonts && document.fonts.ready) document.fonts.ready.then(layout);
    layout();

    // Lightbox over the currently visible set, so Prev/Next follow the filter.
    var box = document.getElementById('lightbox');
    var boxImg = document.getElementById('lightbox-img');
    var boxCap = document.getElementById('lightbox-caption');
    var order = [];
    var at = 0;

    function show(i) {
      order = visible();
      if (!order.length) return;
      at = (i + order.length) % order.length;
      var el = order[at];
      boxImg.src = el.getAttribute('href');
      boxImg.alt = el.dataset.title || '';
      boxCap.textContent = el.dataset.title || '';
    }

    items.forEach(function (el) {
      el.addEventListener('click', function (e) {
        if (!box.showModal) return; // no <dialog> support: follow the link
        e.preventDefault();
        order = visible();
        show(order.indexOf(el));
        box.showModal();
      });
    });

    box.addEventListener('click', function (e) {
      var t = e.target;
      if (t.closest('[data-close]') || t === box) box.close();
      else if (t.closest('[data-prev]')) show(at - 1);
      else if (t.closest('[data-next]')) show(at + 1);
    });

    document.addEventListener('keydown', function (e) {
      if (!box.open) return;
      if (e.key === 'ArrowLeft') show(at - 1);
      if (e.key === 'ArrowRight') show(at + 1);
    });
  })();
</script>
