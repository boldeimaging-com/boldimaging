---
// /category/exterior/ and /category/interior/.
//
// These are the two addresses the "Our Work" flip boxes link to, and on the
// live site they are empty: the portfolio custom post type is not in the
// category archive loop, so WordPress renders the theme's page header and an
// empty `.page-content`. Ported as-is -- an empty archive is what the links
// currently reach, and inventing a listing here would be a redesign, not a
// port. Worth raising with the client separately.
import Base from '../../layouts/Base.astro';
import ThemeArchive from '../../components/ThemeArchive.astro';

export const prerender = true;

export function getStaticPaths() {
  return [
    {
      params: { slug: 'exterior' },
      props: {
        name: 'Exterior',
        description:
          'Exterior signage by BolDe Imaging — pylon signs, fascia signs, channel letters, awnings, construction hoarding and wayfinding across Ontario.',
      },
    },
    {
      params: { slug: 'interior' },
      props: {
        name: 'Interior',
        description:
          'Interior signage by BolDe Imaging — reception walls, wayfinding, cut out letters, push thru signs and custom interior graphics across Ontario.',
      },
    },
  ];
}

const { name, description } = Astro.props as { name: string; description: string };
---

{/*
  `noindex, follow` — the one place where this port deliberately does NOT
  reproduce the old site's indexing.

  Both category archives render the theme's page header and nothing else,
  because the portfolio post type is not in the category loop; see the note at
  the top of this file. WordPress listed them in wp-sitemap.xml and left them
  indexable, so Google holds two empty pages for this domain. They rank for
  nothing and count as thin content.

  `follow` keeps the links crawlable and the addresses keep serving 200, so
  nothing that points here breaks. They are also dropped from sitemap.xml, which
  must never list a noindexed address — Search Console reports that pairing as an
  error. If the client fills these archives, delete this block and restore the
  two paths in src/pages/sitemap.xml.ts.
*/}
<Base
  title={`${name} – BolDe Imaging`}
  description={description}
  pageType="CollectionPage"
  noindex={true}
  breadcrumbs={[
    { name: 'Our Work', href: '/services/' },
    { name, href: `/category/${name.toLowerCase()}/` },
  ]}
>
  <ThemeArchive>
    <Fragment slot="heading">Category: <span>{name}</span></Fragment>
  </ThemeArchive>
</Base>
