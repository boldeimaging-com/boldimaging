---
import '../styles/tokens.css';
import '../styles/fonts.css';
import '../styles/icons.css';
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import SEO from '../components/SEO.astro';
import type { Props as SeoProps } from '../components/SEO.astro';
import { media } from '../consts';

interface Props extends SeoProps {
  /** Home page only: the header sits over the hero and the page has no top gap. */
  bodyClass?: string;
}

const { bodyClass, ...seo } = Astro.props as Props;
const path = Astro.url.pathname;
---

<!doctype html>
<html lang="en-US">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />

    <SEO {...seo} />

    <link rel="icon" href={media('2021/04/cropped-Bolde_logo_for_golf_revised_white-32x32.png')} sizes="32x32" />
    <link rel="icon" href={media('2021/04/cropped-Bolde_logo_for_golf_revised_white-192x192.png')} sizes="192x192" />
    <link rel="apple-touch-icon" href={media('2021/04/cropped-Bolde_logo_for_golf_revised_white-180x180.png')} />
    <meta name="msapplication-TileImage" content={media('2021/04/cropped-Bolde_logo_for_golf_revised_white-270x270.png')} />
  </head>
  <body class={bodyClass}>
    <Header path={path} />
    <main>
      <slot />
    </main>
    <Footer path={path} />
  </body>
</html>
