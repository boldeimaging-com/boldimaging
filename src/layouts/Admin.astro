---
// The frame around every /admin/ page: heading, section nav, sign out, and
// the ?ok= / ?err= message a POST-redirect-GET leaves behind.

interface Props {
  title: string;
  signedIn: boolean;
  active?: 'settings' | 'work';
}

const { title, signedIn, active } = Astro.props as Props;
const ok = Astro.url.searchParams.get('ok');
const err = Astro.url.searchParams.get('err');

Astro.response.headers.set('Cache-Control', 'no-store');
Astro.response.headers.set('X-Robots-Tag', 'noindex, nofollow');
---

<!doctype html>
<html lang="en-CA">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex, nofollow" />
    <title>{title} – BolDe Imaging admin</title>
  </head>
  <body>
    <main class="wrap">
      <header class="top">
        <h1>{title}</h1>
        {
          signedIn && (
            <form method="post" action="/admin/">
              <input type="hidden" name="action" value="logout" />
              <button class="link" type="submit">Sign out</button>
            </form>
          )
        }
      </header>

      {
        signedIn && (
          <nav class="tabs" aria-label="Admin sections">
            <a href="/admin/" aria-current={active === 'settings' ? 'page' : undefined}>Forms</a>
            <a href="/admin/work/" aria-current={active === 'work' ? 'page' : undefined}>Our Work</a>
          </nav>
        )
      }

      {ok && <p class="flash flash--ok" role="status">{ok}</p>}
      {err && <p class="flash flash--err" role="alert">{err}</p>}

      <slot />
    </main>

    <script is:inline>
      document.addEventListener('click', function (e) {
        var b = e.target.closest('[data-confirm]');
        if (b && !confirm(b.getAttribute('data-confirm'))) e.preventDefault();
      });
    </script>
  </body>
</html>

<style is:global>
  :root {
    color-scheme: light;
  }
  body {
    margin: 0;
    background: #f4f4f4;
    color: #222;
    font-family: system-ui, -apple-system, 'Segoe UI', Roboto, sans-serif;
    font-size: 16px;
    line-height: 1.5;
  }
  .wrap {
    max-width: 760px;
    margin: 0 auto;
    padding: 32px 16px 64px;
  }
  .top {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
  }
  .wrap h1 {
    margin: 0 0 12px;
    font-size: 28px;
  }
  .wrap h2 {
    margin: 0 0 4px;
    font-size: 20px;
  }
  .tabs {
    display: flex;
    gap: 20px;
    margin: 0 0 20px;
    border-bottom: 1px solid #ddd;
  }
  .tabs a {
    padding: 6px 0;
    color: #555;
    text-decoration: none;
    border-bottom: 2px solid transparent;
    margin-bottom: -1px;
  }
  .tabs a[aria-current='page'] {
    color: #222;
    border-bottom-color: #222;
    font-weight: 600;
  }
  .card {
    margin: 0 0 24px;
    padding: 20px;
    background: #fff;
    border: 1px solid #ddd;
    border-radius: 6px;
  }
  .hint {
    margin: 0 0 12px;
    color: #555;
  }
  .flash {
    margin: 0 0 16px;
    padding: 10px 14px;
    border-radius: 4px;
  }
  .flash--ok {
    background: #e7f5ea;
    color: #1d5e2c;
  }
  .flash--err {
    background: #fdecec;
    color: #8a1c1c;
  }
  .wrap input:not([type='checkbox']):not([type='file']),
  .wrap textarea {
    width: 100%;
    box-sizing: border-box;
    padding: 8px 10px;
    border: 1px solid #999;
    border-radius: 4px;
    font: inherit;
  }
  .wrap textarea {
    display: block;
    resize: vertical;
  }
  .wrap button,
  .button {
    display: inline-block;
    padding: 8px 14px;
    border: 1px solid #333;
    border-radius: 4px;
    background: #333;
    color: #fff;
    font: inherit;
    text-decoration: none;
    cursor: pointer;
  }
  .wrap button:disabled {
    opacity: 0.35;
    cursor: default;
  }
  .wrap button.icon,
  .button.secondary {
    background: #fff;
    color: #333;
  }
  .wrap button.icon {
    padding: 8px 12px;
  }
  .wrap button.danger {
    background: #fff;
    border-color: #b42318;
    color: #b42318;
  }
  .wrap button.link {
    border: 0;
    background: none;
    color: #333;
    text-decoration: underline;
    padding: 0;
  }
  .field {
    display: block;
    margin: 0 0 14px;
  }
  .field > span {
    display: block;
    font-size: 13px;
    color: #666;
  }
  .actions {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
  }
</style>
